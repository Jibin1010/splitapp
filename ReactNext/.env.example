# Public application configuration
NEXT_PUBLIC_APP_NAME=SplitLedger
NEXT_PUBLIC_DEFAULT_CURRENCY=INR

# Optional future calculation/API provider
# Leave empty — SplitLedger's own /api/calculate endpoint handles all arithmetic
# for v1. These placeholders exist so an external engine can be wired in later
# without touching the UI.
SPLIT_ENGINE_API_URL=
SPLIT_ENGINE_API_KEY=

# Supabase PostgreSQL (5NF Database)
NEXT_PUBLIC_SUPABASE_URL=https://waqyadioyacpuwqjnmui.supabase.co
SUPABASE_URL=https://waqyadioyacpuwqjnmui.supabase.co
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.waqyadioyacpuwqjnmui.supabase.co:5432/postgres

# Google OAuth Credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# WhatsApp User-Initiated Verification (Host number that receives verification messages)
NEXT_PUBLIC_WHATSAPP_BOT_NUMBER=+919876543210
WHATSAPP_WEBHOOK_VERIFY_TOKEN=splitledger_wa_verify_secret

# NVIDIA NIM Vision API (Image description & receipt analysis)
# Model: meta/llama-3.2-11b-vision-instruct
NVIDIA_API_KEY=
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1

# SECURITY: never prefix secret values (like SPLIT_ENGINE_API_KEY) with
# NEXT_PUBLIC_ — variables with that prefix are exposed to the browser bundle.
# Keep secrets server-side and exclude .env.local from version control.
